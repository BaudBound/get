#!/bin/sh

set -eu

# Flip to 1 at the first public app release. The contract tests rewrite this
# exact line to exercise the rest of the script, so keep it on its own line and
# keep the spelling unchanged.
downloads_enabled=0

fail() {
    printf 'BaudBound installer: %s\n' "$1" >&2
    exit 1
}

if [ "$downloads_enabled" -eq 0 ]; then
    printf '%s\n' \
        "BaudBound installer: downloads are paused until the first public app release." \
        "Follow development on GitHub: https://github.com/BaudBound/baudbound" >&2
    exit 1
fi

# BAUDBOUND_TEST_* variables exist for the contract tests, which cannot supply a
# real machine or distribution. They only substitute detection inputs; every
# check below still runs.
machine="${BAUDBOUND_TEST_UNAME_M:-$(uname -m)}"
case "$machine" in
    x86_64) debian_arch="amd64"; rpm_arch="x86_64" ;;
    aarch64 | arm64) debian_arch="arm64"; rpm_arch="aarch64" ;;
    *)
        fail "unsupported CPU architecture ${machine}. BaudBound supports x86_64 and aarch64 Linux."
        ;;
esac

if [ -n "${BAUDBOUND_TEST_OS_ID:-}" ]; then
    os_id="$BAUDBOUND_TEST_OS_ID"
else
    [ -r /etc/os-release ] || fail "cannot read /etc/os-release to identify this system."
    # Read the value rather than sourcing the file. Sourcing executes whatever
    # the file contains, and this script goes on to invoke a package manager
    # with elevated rights, so the identifier is extracted textually and
    # stripped of the optional quoting the format allows.
    os_id="$(
        awk -F= '$1 == "ID" {
            value = $2
            gsub(/^["'"'"']|["'"'"']$/, "", value)
            print value
            exit
        }' /etc/os-release
    )"
fi

case "$os_id" in
    *[!a-z0-9._-]* | "")
        fail "could not identify this system from /etc/os-release."
        ;;
esac

# 64-bit Raspberry Pi OS reports ID=debian and is served by the Debian branch.
# The raspbian identifier belongs to the 32-bit image, which the architecture
# check above has already refused.
case "$os_id" in
    debian | ubuntu | raspbian)
        package_suffix="_${debian_arch}.deb"
        package_manager="apt-get"
        ;;
    fedora)
        package_suffix=".${rpm_arch}.rpm"
        package_manager="dnf"
        ;;
    *)
        fail "no tested native package for ${os_id}. See https://wiki.baudbound.app/runner/installation"
        ;;
esac

if [ -n "${BAUDBOUND_TEST_PLAN_ONLY:-}" ]; then
    printf 'Would install a package ending in %s using %s.\n' "$package_suffix" "$package_manager"
    exit 0
fi

# Checked before anything is downloaded, so a system that cannot install the
# package finds out before fetching it. The contract tests reach the download
# path from a machine with no package manager, and skip only this check.
if [ -z "${BAUDBOUND_TEST_NO_INSTALL:-}" ]; then
    command -v "$package_manager" >/dev/null 2>&1 \
        || fail "required package manager ${package_manager} is not available."
fi

# jq is required rather than optional. The alternative is matching patterns
# against JSON with line tools, which breaks the moment a field is reordered or
# a value is escaped, and this parse decides which file gets installed with
# elevated rights.
for tool in curl sha256sum jq; do
    command -v "$tool" >/dev/null 2>&1 \
        || fail "required tool ${tool} is not available. Install it and run the installer again."
done

feed="${BAUDBOUND_TEST_FEED:-https://api.github.com/repos/BaudBound/baudbound/releases/latest}"

release_json="$(curl --fail --silent --show-error --location "$feed")" \
    || fail "could not reach the BaudBound release feed."

asset_url="$(
    printf '%s' "$release_json" \
        | jq -r --arg suffix "$package_suffix" \
            'first(.assets[] | select(.name | endswith($suffix)) | .browser_download_url) // empty'
)" || fail "could not read the BaudBound release feed."
[ -n "$asset_url" ] || fail "release has no asset ending in ${package_suffix}."

sums_url="$(
    printf '%s' "$release_json" \
        | jq -r 'first(.assets[] | select(.name == "SHA256SUMS") | .browser_download_url) // empty'
)" || fail "could not read the BaudBound release feed."
[ -n "$sums_url" ] || fail "release has no SHA256SUMS manifest."

work_directory="$(mktemp -d)"
trap 'rm -rf "$work_directory"' EXIT
chmod 700 "$work_directory"

asset_name="${asset_url##*/}"
curl --fail --silent --show-error --location --output "$work_directory/$asset_name" "$asset_url" \
    || fail "could not download ${asset_name}."
curl --fail --silent --show-error --location --output "$work_directory/SHA256SUMS" "$sums_url" \
    || fail "could not download the checksum manifest."

expected_digest="$(awk -v name="$asset_name" '$2 == name { print $1; exit }' "$work_directory/SHA256SUMS")"
[ -n "$expected_digest" ] || fail "${asset_name} is absent from the checksum manifest."

actual_digest="$(sha256sum "$work_directory/$asset_name" | awk '{ print $1 }')"
[ "$expected_digest" = "$actual_digest" ] \
    || fail "${asset_name} checksum does not match the published manifest."

printf 'BaudBound installer: verified %s\n' "$asset_name"

if [ -n "${BAUDBOUND_TEST_NO_INSTALL:-}" ]; then
    exit 0
fi

printf 'BaudBound installer: installing %s with %s. Administrator approval is required.\n' \
    "$asset_name" "$package_manager"

case "$package_manager" in
    apt-get) sudo apt-get install --yes "$work_directory/$asset_name" ;;
    dnf) sudo dnf install --assumeyes "$work_directory/$asset_name" ;;
esac
